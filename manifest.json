{
  "manifest_version": 3,
  "name": "Reverso Checker (non officiel)",
  "version": "0.2.0",
  "description": "Correcteur d'orthographe et de grammaire dans les champs de texte, propulsé par le correcteur en ligne de Reverso. Non affilié à Reverso.",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "https://orthographe.reverso.net/*",
    "https://docs.googleapis.com/*",
    "https://docs.google.com/*"
  ],
  "oauth2": {
    "client_id": "REMPLACER_PAR_VOTRE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "gdocs-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "common.js",
        "gdocs.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Reverso Checker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
